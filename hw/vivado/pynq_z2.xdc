## SPDX-License-Identifier: MIT
## PYNQ-Z2 (xc7z020clg400-1) Master Timing & I/O Constraints
## For Heterogeneous CPU-NPU-Compute GPU System

## Note: FCLK_CLK0 (100 MHz) timing constraint is automatically generated by
## the Zynq7 Processing System IP in the Block Design (create_bd.tcl).
## For standalone / OOC synthesis of npu_top or gpu_top, synth_check.tcl
## creates a 10.000 ns (100 MHz) clock on port 'clk'.

## ----------------------------------------------------------------------------
## Optional Status LEDs (LD0..LD3 on PYNQ-Z2)
## ----------------------------------------------------------------------------
#set_property -dict { PACKAGE_PIN R14   IOSTANDARD LVCMOS33 } [get_ports { leds[0] }]; # LD0
#set_property -dict { PACKAGE_PIN P14   IOSTANDARD LVCMOS33 } [get_ports { leds[1] }]; # LD1
#set_property -dict { PACKAGE_PIN N16   IOSTANDARD LVCMOS33 } [get_ports { leds[2] }]; # LD2
#set_property -dict { PACKAGE_PIN M14   IOSTANDARD LVCMOS33 } [get_ports { leds[3] }]; # LD3

## ----------------------------------------------------------------------------
## HDMI TX (TMDS Output on PYNQ-Z2 for real-time token & telemetry display)
## ----------------------------------------------------------------------------
#set_property -dict { PACKAGE_PIN L17   IOSTANDARD TMDS_33  } [get_ports { hdmi_tx_clk_n }];
#set_property -dict { PACKAGE_PIN L16   IOSTANDARD TMDS_33  } [get_ports { hdmi_tx_clk_p }];
#set_property -dict { PACKAGE_PIN K18   IOSTANDARD TMDS_33  } [get_ports { hdmi_tx_d_n[0] }];
#set_property -dict { PACKAGE_PIN K17   IOSTANDARD TMDS_33  } [get_ports { hdmi_tx_d_p[0] }];
#set_property -dict { PACKAGE_PIN K19   IOSTANDARD TMDS_33  } [get_ports { hdmi_tx_d_n[1] }];
#set_property -dict { PACKAGE_PIN J19   IOSTANDARD TMDS_33  } [get_ports { hdmi_tx_d_p[1] }];
#set_property -dict { PACKAGE_PIN J18   IOSTANDARD TMDS_33  } [get_ports { hdmi_tx_d_n[2] }];
#set_property -dict { PACKAGE_PIN H18   IOSTANDARD TMDS_33  } [get_ports { hdmi_tx_d_p[2] }];
#set_property -dict { PACKAGE_PIN R19   IOSTANDARD LVCMOS33 } [get_ports { hdmi_tx_hpdn }];
